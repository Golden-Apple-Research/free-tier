---
// Statischer Einstieg: leitet auf die Default-Sprache /de/ weiter.
// GitHub Pages kann keine Server-Redirects — deshalb Meta-Refresh (Basis-pfad-
// agnostisch via relativer URL) plus Canonical und noscript-Fallback.
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Free-Tier Übersicht</title>
    <meta http-equiv="refresh" content="0;url=./de/" />
    <link rel="canonical" href="./de/" />
  </head>
  <body>
    <noscript>
      <p><a href="./de/">Weiter zur deutschen Dokumentation</a></p>
    </noscript>
  </body>
</html>
